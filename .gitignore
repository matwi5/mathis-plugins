# Python
__pycache__/
*.pyc

# Systèmes
.DS_Store
Thumbs.db

# Outils
node_modules/

# Sauvegardes et secrets
*.bak-sync-*
.env*

# Propre à un poste : jamais versionné, sauf .claude/settings.json, les réglages du dépôt quand il en
# a (alors présents dans chaque worktree) ; les worktrees, settings.local.json et le .claude d'un
# sous-dossier restent ignorés
/.claude/*
!/.claude/settings.json
*/**/.claude/
*.jsonl
.machine
claude-usage/
plugins/*/.claude-plugin/types/
# Le titre du mode « --titre » de la sonde (scripts/sonde.py).
scripts/sonde/titre.txt
