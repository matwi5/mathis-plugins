#!/bin/sh
# Hook pre-commit du dépôt, installé par scripts/sync.py (core.hooksPath = scripts/hooks) :
# validate du dépôt et tests des plugins dont un fichier est indexé, avec le Claude Code du
# terminal ; rien pour un commit de documentation seule (scripts/check.py --staged).
# Git for Windows lance aussi ce script, par son sh.
root=$(git rev-parse --show-toplevel) || exit 1
exec sh "$root/scripts/check.sh" --staged
