#!/bin/sh
# Hook pre-commit du dépôt, installé par scripts/sync.py (core.hooksPath = scripts/hooks), sur le contenu
# de l'index (pas l'arbre de travail) : même pour un commit de documentation seule, les numéros de série des
# fichiers de décisions indexés (travail/*/DECISIONS.md), puis la forme du CHANGELOG, la version et la
# liste « État » d'un plugin dont le CHANGELOG ou le plugin.json est indexé ; hors documentation seule,
# validate du dépôt, puis validate, tsc et tests des plugins dont un fichier est indexé, sur une copie de l'index, avec le Claude
# Code du terminal, sauf pour un plugin dont l'index est exactement celui que scripts/check.sh vient de
# passer (scripts/check.py --staged).
# Git for Windows lance aussi ce script, par son sh.
root=$(git rev-parse --show-toplevel) || exit 1
exec sh "$root/scripts/check.sh" --staged
